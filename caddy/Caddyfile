# Caddy configuration for Gophish phishing landing pages
# This proxies all traffic to the Gophish phishing server

# Production domain - update this to your actual domain
phish.example.com {
	# Proxy all requests to the Gophish phishing server
	reverse_proxy gophish:80 {
		# Preserve headers for proper logging
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.proto}
		header_up X-Real-IP {http.request.remote.host}
	}
	
	# Compression
	encode zstd gzip
	
	# Security headers
	header X-Frame-Options "SAMEORIGIN"
	header X-Content-Type-Options "nosniff"
	header X-XSS-Protection "1; mode=block"
}

# HTTP to HTTPS redirect for non-matching hosts
:80 {
	redir https://{host}{uri} permanent
}
