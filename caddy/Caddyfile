# Caddy configuration for Gophish phishing landing pages
# This proxies all traffic to the Gophish phishing server

# Production domain - update this to your actual domain
phish.skippycrm.nl {
	reverse_proxy gophish.railway.internal:80 {
		# Preserve headers for proper logging
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.proto}
		header_up X-Real-IP {http.request.remote.host}
	}
	
	# Compression
	encode zstd gzip
	
	# Security headers
	header X-Frame-Options "SAMEORIGIN"
	header X-Content-Type-Options "nosniff"
	header X-XSS-Protection "1; mode=block"
}

# Admin Panel reverse proxy (using exact domain for Caddy matcher)
cozy-rebirth-production-de31.up.railway.app {
    reverse_proxy gophish.railway.internal:3333
}

# HTTP to HTTPS redirect for non-matching hosts
:80 {
	redir https://{host}{uri} permanent
}
